<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TechSolutions | Modern Digital Solutions</title>

<link rel="stylesheet" href="/css/index.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>
<body>

<!-- Navbar -->

<header>
    <nav class="navbar">

        <div class="logo">
            🚀 TechSolutions
        </div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="/login">Manage</a></li>
        </ul>

    </nav>
</header>

<!-- Hero Section -->

<section class="hero" id="home">

    <div class="hero-content">

        <h1>
            Transform Your Business With Smart Technology
        </h1>

        <p>
            Web Development • Mobile Apps • Cloud Solutions • Database Systems
        </p>

        <a href="#services" class="btn">
            Explore Services
        </a>

    </div>

</section>

<!-- Stats Section -->

<section class="stats">

    <div class="stats-grid">

        <div class="stat-box">
            <h3>50+</h3>
            <p>Projects Completed</p>
        </div>

        <div class="stat-box">
            <h3>30+</h3>
            <p>Happy Clients</p>
        </div>

        <div class="stat-box">
            <h3>99%</h3>
            <p>Client Satisfaction</p>
        </div>

    </div>

</section>

<!-- About -->

<section class="about" id="about">

    <div class="container">

        <h2>About Us</h2>

        <div class="about-cards">

            <div class="card">
                <i class="fas fa-bullseye"></i>

                <h3>Mission</h3>

                <p>
                    Deliver innovative digital solutions that help businesses grow.
                </p>
            </div>

            <div class="card">
                <i class="fas fa-eye"></i>

                <h3>Vision</h3>

                <p>
                    Build future-ready technology that transforms industries.
                </p>
            </div>

            <div class="card">
                <i class="fas fa-users"></i>

                <h3>Expert Team</h3>

                <p>
                    Skilled developers focused on quality and performance.
                </p>
            </div>

        </div>

    </div>

</section>

<!-- Services -->

<section class="services" id="services">

    <div class="container">

        <h2>Our Services</h2>

        <div class="service-boxes">

            <div class="service-card">
                <i class="fas fa-code"></i>

                <h3>Web Development</h3>

                <p>
                    Fast, responsive and SEO-friendly websites.
                </p>
            </div>

            <div class="service-card">
                <i class="fas fa-mobile-screen"></i>

                <h3>App Development</h3>

                <p>
                    Android and cross-platform mobile applications.
                </p>
            </div>

            <div class="service-card">
                <i class="fas fa-database"></i>

                <h3>Database Design</h3>

                <p>
                    MySQL and MongoDB solutions for modern applications.
                </p>
            </div>

            <div class="service-card">
                <i class="fas fa-cloud"></i>

                <h3>Cloud Solutions</h3>

                <p>
                    Scalable cloud deployment and management services.
                </p>
            </div>

            <div class="service-card">
                <i class="fas fa-shield-halved"></i>

                <h3>Cyber Security</h3>

                <p>
                    Secure systems and data protection strategies.
                </p>
            </div>

            <div class="service-card">
                <i class="fas fa-chart-line"></i>

                <h3>Digital Growth</h3>

                <p>
                    Technology-driven solutions to grow your business.
                </p>
            </div>

        </div>

    </div>

</section>

<!-- Why Choose Us -->

<section class="about">

    <div class="container">

        <h2>Why Choose Us?</h2>

        <div class="about-cards">

            <div class="card">
                <i class="fas fa-bolt"></i>
                <h3>Fast Delivery</h3>
                <p>Quick turnaround without compromising quality.</p>
            </div>

            <div class="card">
                <i class="fas fa-lock"></i>
                <h3>Secure Systems</h3>
                <p>Modern security practices and data protection.</p>
            </div>

            <div class="card">
                <i class="fas fa-headset"></i>
                <h3>24/7 Support</h3>
                <p>Dedicated support whenever you need help.</p>
            </div>

        </div>

    </div>

</section>

<!-- Portfolio -->

<section class="portfolio" id="portfolio">

    <div class="container">

        <h2>Portfolio</h2>

        <div class="portfolio-grid">

            <div class="portfolio-item">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop">
            </div>

            <div class="portfolio-item">
                <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?q=80&w=1200&auto=format&fit=crop">
            </div>

            <div class="portfolio-item">
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop">
            </div>

        </div>

    </div>

</section>

<!-- Contact -->

<section class="contact" id="contact">

    <div class="container">

        <h2>Contact Us</h2>

        <form action="/contact" method="POST" class="contact-form">

            <input
            type="text"
            name="name"
            placeholder="Your Name"
            required>

            <input
            type="email"
            name="email"
            placeholder="Your Email"
            required>

            <input
            type="tel"
            name="mobile_number"
            placeholder="Phone Number"
            required>

            <textarea
            rows="5"
            name="message"
            placeholder="Your Message"></textarea>

            <button type="submit">
                Send Message
            </button>

        </form>

    </div>

</section>

<!-- Footer -->

<footer>
    <p>
        © 2026 TechSolutions. All Rights Reserved.
    </p>
</footer>

</body>
</html>