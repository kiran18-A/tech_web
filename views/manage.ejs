<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manage Contacts</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f4f7fc;
    min-height:100vh;
    padding:30px 15px;
}

.container{
    max-width:1300px;
    margin:auto;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:15px;
    margin-bottom:25px;
}

.header h1{
    color:#1f2937;
    font-size:32px;
}

.top-controls{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.search-box{
    padding:12px 15px;
    border:1px solid #ddd;
    border-radius:10px;
    min-width:250px;
    outline:none;
}

.filter{
    padding:12px 15px;
    border:1px solid #ddd;
    border-radius:10px;
    outline:none;
    cursor:pointer;
}

.card{
    background:#fff;
    border-radius:20px;
    padding:25px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.table-wrapper{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:900px;
}

thead{
    background:#4f46e5;
    color:white;
}

th{
    padding:16px;
    text-align:left;
    font-weight:600;
}

td{
    padding:16px;
    border-bottom:1px solid #eee;
}

tbody tr{
    transition:.3s;
}

tbody tr:hover{
    background:#f8f9ff;
}

.status{
    padding:7px 14px;
    border-radius:30px;
    font-size:13px;
    font-weight:600;
}

.pending{
    background:#fff3cd;
    color:#856404;
}

.contacted{
    background:#d4edda;
    color:#155724;
}

.btn{
    border:none;
    padding:10px 14px;
    border-radius:8px;
    cursor:pointer;
    font-weight:500;
    transition:.3s;
}

.btn-contact{
    background:#10b981;
    color:white;
}

.btn-contact:hover{
    transform:translateY(-2px);
}

.btn-delete{
    background:#ef4444;
    color:white;
    margin-left:8px;
}

.btn-delete:hover{
    transform:translateY(-2px);
}

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:25px;
}

.stat-box{
    background:white;
    padding:25px;
    border-radius:18px;
    box-shadow:0 5px 20px rgba(0,0,0,.07);
}

.stat-box h3{
    color:#666;
    font-size:14px;
    margin-bottom:10px;
}

.stat-box h2{
    color:#111827;
    font-size:30px;
}

@media(max-width:768px){

.header{
    flex-direction:column;
    align-items:stretch;
}

.top-controls{
    flex-direction:column;
}

.search-box,
.filter{
    width:100%;
}

.card{
    padding:15px;
}

.header h1{
    font-size:26px;
}

}

</style>
</head>
<body>
    
<div class="container">
    <a href="/">back</a>
    <div class="header">
        <h1>Contact Management</h1>

        <form method="GET" action="/manage">
            <div class="top-controls">
                <select onchange="this.form.submit()" class="filter" name="status">
                    <option value="">All</option>
                    <option value="pending">Pending</option>
                    <option value="contacted">Contacted</option>
                </select>
            </div>
        </form>
    </div>

    <div class="stats">
        <div class="stat-box">
            <h3>Total Contacts</h3>
            <h2><%= total_contacts.length %></h2>
        </div>

        <div class="stat-box">
            <h3>Pending</h3>
            <h2><%= pending_contacts.length %></h2>
        </div>

        <div class="stat-box">
            <h3>Contacted</h3>
            <h2><%= total_viewed.length %></h2>
        </div>
    </div>

    <div class="card">

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% for (const contact of contacts) { %>
                        <tr>
                            <td><%= contact.name %></td>
                            <td><%= contact.email %></td>
                            <td><%= contact.phone %></td>
                            <td><%= contact.message %></td>

                            <% if (contact.status === 'pending') { %>
                                <td>
                                    <span class="status pending">
                                        Pending
                                    </span>
                                </td>
                            <% } else if (contact.status === 'contacted') { %>
                            <td>
                                <span class="status contacted">
                                    Contacted
                                </span>
                            </td>
                            <% } %>                           
                            <td>
                                <form method="POST" action="/mark_contacted/<%= contact.id %>">
                                    <button class="btn btn-contact" >Mark as Contacted</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>
</html>